{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and mini-player webviews only",
  "webviews": ["main", "mini-player"],
  "permissions": [
    "main-commands",
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-is-fullscreen",
    "core:window:allow-is-maximized",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-decorations",
    "autostart:allow-is-enabled",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/2latemc/JustAnotherMusicClient" },
        { "url": "https://github.com/2latemc/JustAnotherMusicClient/**" },
        { "url": "https://ko-fi.com/totally2late" },
        { "url": "https://justanothermusicclient.userjot.com/**" },
        { "url": "https://www.last.fm/api/auth/**" }
      ]
    },
    "updater:allow-check",
    "process:allow-restart",
    "dialog:allow-open",
    "dialog:allow-message",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-current-monitor",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-cursor-position",
    "core:window:allow-set-cursor-icon",
    "core:window:allow-set-ignore-cursor-events"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/*"
    ]
  }
}
